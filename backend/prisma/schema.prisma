generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id             String             @id
  code           String             @unique
  name           String
  companyId      String
  accountTypeId  String
  parentId       String?
  isActive       Boolean            @default(true)
  openingBalance Float              @default(0)
  currentBalance Float              @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime
  allowNegative  Boolean            @default(false)
  category       String?
  cashFlowType   String?
  accountType    AccountType        @relation(fields: [accountTypeId], references: [id])
  company        Company            @relation(fields: [companyId], references: [id])
  parent         Account?           @relation("AccountToAccount", fields: [parentId], references: [id])
  children       Account[]          @relation("AccountToAccount")
  employeeAdvances EmployeeAdvance[]
  employeeExpenses EmployeeExpense[]
  journalLines   JournalEntryLine[]
  payments       Payment[]

  @@index([accountTypeId])
  @@index([companyId])
}

model AccountType {
  id       String    @id
  name     String    @unique
  type     String
  isActive Boolean   @default(true)
  accounts Account[]
}

model ActivityLog {
  id            String   @id
  companyId     String
  entityType    String
  entityId      String
  action        String
  performedById String
  targetUserId  String?
  branchId      String?
  metadata      Json?
  createdAt     DateTime @default(now())
  branch        Branch?  @relation(fields: [branchId], references: [id])
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  performedBy   User     @relation("ActivityLog_performedByIdToUser", fields: [performedById], references: [id])
  targetUser    User?    @relation("ActivityLog_targetUserIdToUser", fields: [targetUserId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([performedById])
  @@index([targetUserId])
}

model Attachment {
  id           String   @id
  name         String
  fileName     String
  fileType     String
  filePath     String
  fileSize     Int
  entityType   String
  entityId     String
  documentType String?
  hashValue    String?
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  verifiedById String?
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
}

model BackupLog {
  id          String   @id
  fileName    String
  fileSize    Int
  status      String
  triggeredBy String
  createdAt   DateTime @default(now())
}

model Bill {
  id         String    @id
  billNumber String    @unique
  companyId  String
  vendorId   String
  status     String    @default("DRAFT")
  subtotal   Float
  taxAmount  Float     @default(0)
  total      Float
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  company    Company   @relation(fields: [companyId], references: [id])
  vendor     Vendor    @relation(fields: [vendorId], references: [id])
  payments   Payment[]

  @@index([companyId])
  @@index([vendorId])
}

model Branch {
  id           String             @id
  code         String             @unique
  name         String
  companyId    String
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime
  activityLogs ActivityLog[]
  company      Company            @relation(fields: [companyId], references: [id])
  journalEntries JournalEntry[]
  journalLines JournalEntryLine[]

  @@unique([companyId, code])
}

model Company {
  id                     String                  @id
  code                   String                  @unique
  name                   String
  logoUrl                String?
  address                String?
  city                   String?
  country                String?
  phone                  String?
  email                  String?
  website                String?
  baseCurrency           String                  @default("BDT")
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  accounts               Account[]
  activityLogs           ActivityLog[]
  bills                  Bill[]
  branches               Branch[]
  settings               CompanySettings?
  costCenters            CostCenter[]
  customers              Customer[]
  employees              Employee[]
  employeeAdvances       EmployeeAdvance[]
  employeeExpenses       EmployeeExpense[]
  employeeLoans          EmployeeLoan[]
  employeeLoanRepayments EmployeeLoanRepayment[]
  invoices               Invoice[]
  journals               JournalEntry[]
  lcs                    LC[]
  loans                  Loan[]
  notifications          Notification[]
  pis                    PI[]
  products               Product[]
  projects               Project[]
  purchaseOrders         PurchaseOrder[]
  userCompanies          UserCompany[]
  vendors                Vendor[]
}

model CompanySettings {
  id        String   @id
  companyId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CostCenter {
  id           String             @id
  code         String             @unique
  name         String
  companyId    String
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime
  company      Company            @relation(fields: [companyId], references: [id])
  journalLines JournalEntryLine[]

  @@unique([companyId, code])
}

model Currency {
  id             String         @id
  code           String         @unique
  name           String
  symbol         String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  isBase         Boolean        @default(false)
  ratesFrom      ExchangeRate[] @relation("ExchangeRate_fromCurrencyIdToCurrency")
  ratesTo        ExchangeRate[] @relation("ExchangeRate_toCurrencyIdToCurrency")
  journalEntries JournalEntry[]
}

model Customer {
  id                String             @id
  code              String             @unique
  name              String
  companyId         String
  email             String?
  phone             String?
  address           String?
  city              String?
  country           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  balanceType       String?
  contactPerson     String?
  creditLimit       Float?
  openingBalance    Float              @default(0)
  preferredCurrency String             @default("BDT")
  tinVat            String?
  paymentTerms      String             @default("COD")
  company           Company            @relation(fields: [companyId], references: [id])
  invoices          Invoice[]
  journalLines      JournalEntryLine[]
  lcs               LC[]
  pis               PI[]

  @@index([companyId])
}

model Employee {
  id           String            @id
  employeeCode String            @unique
  firstName    String
  lastName     String
  email        String?
  phone        String?
  designation  String?
  department   String?
  joinDate     DateTime?
  salary       Float             @default(0)
  companyId    String
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime
  paymentTerms String            @default("BANK")
  company      Company           @relation(fields: [companyId], references: [id])
  advances     EmployeeAdvance[]
  expenses     EmployeeExpense[]
  loans        EmployeeLoan[]

  @@index([companyId])
}

model EmployeeAdvance {
  id             String        @id
  employeeId     String
  amount         Float
  purpose        String?
  date           DateTime
  status         String        @default("DRAFT")
  paymentMethod  String?
  accountId      String?
  journalEntryId String?
  companyId      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  account        Account?      @relation(fields: [accountId], references: [id])
  company        Company       @relation(fields: [companyId], references: [id])
  employee       Employee      @relation(fields: [employeeId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([companyId])
  @@index([employeeId])
}

model EmployeeExpense {
  id             String        @id
  employeeId     String
  amount         Float
  purpose        String?
  date           DateTime
  status         String        @default("DRAFT")
  paymentMethod  String?
  accountId      String?
  journalEntryId String?
  companyId      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  account        Account?      @relation(fields: [accountId], references: [id])
  company        Company       @relation(fields: [companyId], references: [id])
  employee       Employee      @relation(fields: [employeeId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([companyId])
  @@index([employeeId])
}

model EmployeeLoan {
  id              String                  @id
  employeeId      String
  principalAmount Float
  interestRate    Float                   @default(0)
  interestAmount  Float                   @default(0)
  totalAmount     Float
  installments    Int                     @default(1)
  startDate       DateTime
  purpose         String?
  status          String                  @default("DRAFT")
  companyId       String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime
  company         Company                 @relation(fields: [companyId], references: [id])
  employee        Employee                @relation(fields: [employeeId], references: [id])
  repayments      EmployeeLoanRepayment[]

  @@index([companyId])
  @@index([employeeId])
}

model EmployeeLoanRepayment {
  id             String        @id
  loanId         String
  amount         Float
  date           DateTime
  status         String        @default("DRAFT")
  journalEntryId String?
  companyId      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  company        Company       @relation(fields: [companyId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  loan           EmployeeLoan  @relation(fields: [loanId], references: [id])

  @@index([companyId])
  @@index([loanId])
}

model ExchangeRate {
  id             String   @id
  fromCurrencyId String
  toCurrencyId   String
  rate           Float
  rateDate       DateTime @default(now())
  source         String   @default("MANUAL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  fromCurrency   Currency @relation("ExchangeRate_fromCurrencyIdToCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("ExchangeRate_toCurrencyIdToCurrency", fields: [toCurrencyId], references: [id])

  @@index([rateDate])
}

model Invoice {
  id              String        @id
  invoiceNumber   String        @unique
  companyId       String
  customerId      String?
  currency        String        @default("BDT")
  exchangeRate    Float         @default(1)
  subtotal        Float
  taxAmount       Float         @default(0)
  discountAmount  Float         @default(0)
  total           Float
  status          String        @default("DRAFT")
  createdById     String
  verifiedById    String?
  approvedById    String?
  rejectedById    String?
  rejectionReason String?
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  verifiedAt      DateTime?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  type            String        @default("SALES")
  vendorId        String?
  paymentSplits   Json?
  approvedBy      User?         @relation("Invoice_approvedByIdToUser", fields: [approvedById], references: [id])
  company         Company       @relation(fields: [companyId], references: [id])
  createdBy       User          @relation("Invoice_createdByIdToUser", fields: [createdById], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  rejectedBy      User?         @relation("Invoice_rejectedByIdToUser", fields: [rejectedById], references: [id])
  vendor          Vendor?       @relation(fields: [vendorId], references: [id])
  verifiedBy      User?         @relation("Invoice_verifiedByIdToUser", fields: [verifiedById], references: [id])
  lines           InvoiceLine[]
  payments        Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([vendorId])
}

model InvoiceLine {
  id          String   @id
  invoiceId   String
  description String?
  quantity    Float    @default(1)
  unitPrice   Float
  taxRate     Float    @default(0)
  amount      Float
  productId   String?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

model JournalEntry {
  id                     String                  @id
  entryNumber            String                  @unique
  companyId              String
  date                   DateTime                @default(now())
  description            String?
  reference              String?
  status                 String                  @default("DRAFT")
  totalDebit             Float                   @default(0)
  totalCredit            Float                   @default(0)
  createdById            String
  verifiedById           String?
  approvedById           String?
  rejectedById           String?
  rejectionReason        String?
  verifiedAt             DateTime?
  approvedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  branchId               String?
  currencyId             String?
  exchangeRate           Float                   @default(1)
  employeeAdvances       EmployeeAdvance[]
  employeeExpenses       EmployeeExpense[]
  employeeLoanRepayments EmployeeLoanRepayment[]
  approvedBy             User?                   @relation("JournalEntry_approvedByIdToUser", fields: [approvedById], references: [id])
  branch                 Branch?                 @relation(fields: [branchId], references: [id])
  company                Company                 @relation(fields: [companyId], references: [id])
  createdBy              User                    @relation("JournalEntry_createdByIdToUser", fields: [createdById], references: [id])
  currency               Currency?               @relation(fields: [currencyId], references: [id])
  rejectedBy             User?                   @relation("JournalEntry_rejectedByIdToUser", fields: [rejectedById], references: [id])
  verifiedBy             User?                   @relation("JournalEntry_verifiedByIdToUser", fields: [verifiedById], references: [id])
  lines                  JournalEntryLine[]

  @@index([companyId])
  @@index([status])
}

model JournalEntryLine {
  id             String       @id
  journalEntryId String
  accountId      String
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?
  branchId       String?
  costCenterId   String?
  customerId     String?
  projectId      String?
  vendorId       String?
  creditBase     Float        @default(0)
  creditForeign  Float        @default(0)
  debitBase      Float        @default(0)
  debitForeign   Float        @default(0)
  exchangeRate   Float        @default(1)
  reconciled     Boolean      @default(false)
  reconciledAt   DateTime?
  account        Account      @relation(fields: [accountId], references: [id])
  branch         Branch?      @relation(fields: [branchId], references: [id])
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id])
  vendor         Vendor?      @relation(fields: [vendorId], references: [id])
}

model LC {
  id                String          @id
  companyId         String
  lcNumber          String          @unique
  bankName          String
  amount            Float
  currency          String          @default("USD")
  issueDate         DateTime
  expiryDate        DateTime
  status            String          @default("OPEN")
  type              String          @default("IMPORT")
  description       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  conversionRate    Float           @default(1)
  customerId        String?
  loanType          String          @default("NONE")
  loanValue         Float           @default(0)
  receivedDate      DateTime?
  bankBranch        String?
  portOfDestination String?
  portOfLoading     String?
  shipmentDate      DateTime?
  vendorId          String?
  vesselName        String?
  company           Company         @relation(fields: [companyId], references: [id])
  customer          Customer?       @relation(fields: [customerId], references: [id])
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])
  pis               PI[]
  payments          Payment[]
  purchaseOrders    PurchaseOrder[]

  @@index([companyId])
  @@index([customerId])
  @@index([lcNumber])
}

model Loan {
  id                 String    @id
  companyId          String
  loanNumber         String    @unique
  bankName           String
  principalAmount    Float
  interestRate       Float
  repaymentTerm      Int
  monthlyInstallment Float
  outstandingBalance Float
  startDate          DateTime
  endDate            DateTime?
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  company            Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([loanNumber])
}

model Notification {
  id         String   @id
  companyId  String
  type       String
  severity   String   @default("INFO")
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isRead])
}

model PI {
  id                      String      @id
  piNumber                String      @unique
  lcId                    String?
  piDate                  DateTime    @default(now())
  amount                  Float
  currency                String      @default("USD")
  status                  String      @default("OPEN")
  createdAt               DateTime    @default(now())
  updatedAt               DateTime
  bankAcceptanceDate      DateTime?
  customerId              String?
  idbpNumber              String?
  invoiceNumber           String?
  maturityDate            DateTime?
  purchaseAmount          Float?
  purchaseApplicationDate DateTime?
  submissionToBankDate    DateTime?
  submissionToBuyerDate   DateTime?
  companyId               String
  exchangeRate            Float       @default(1)
  totalBDT                Float?
  vendorId                String?
  company                 Company     @relation(fields: [companyId], references: [id])
  customer                Customer?   @relation(fields: [customerId], references: [id])
  lc                      LC?         @relation(fields: [lcId], references: [id])
  vendor                  Vendor?     @relation(fields: [vendorId], references: [id])
  lines                   PILine[]
  paymentAllocations      PaymentPI[]

  @@index([lcId])
}

model PILine {
  id          String   @id
  piId        String
  productId   String?
  description String?
  quantity    Float    @default(1)
  unitPrice   Float
  total       Float
  pi          PI       @relation(fields: [piId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id            String      @id
  paymentNumber String      @unique
  companyId     String
  date          DateTime    @default(now())
  amount        Float
  currency      String      @default("BDT")
  method        String
  reference     String?
  description   String?
  status        String      @default("APPROVED")
  invoiceId     String?
  billId        String?
  accountId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  lcId          String?
  account       Account?    @relation(fields: [accountId], references: [id])
  bill          Bill?       @relation(fields: [billId], references: [id])
  invoice       Invoice?    @relation(fields: [invoiceId], references: [id])
  lc            LC?         @relation(fields: [lcId], references: [id])
  piAllocations PaymentPI[]

  @@index([billId])
  @@index([companyId])
  @@index([invoiceId])
  @@index([lcId])
}

model PaymentPI {
  id              String  @id
  paymentId       String
  piId            String
  allocatedAmount Float
  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  pi              PI      @relation(fields: [piId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([piId])
}

model Product {
  id                String              @id
  code              String
  name              String
  companyId         String
  sku               String?
  description       String?
  unitPrice         Float               @default(0)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  currency          String              @default("BDT")
  exchangeRate      Float               @default(1)
  priceBDT          Float               @default(0)
  isInventory       Boolean             @default(true)
  lowStockThreshold Float               @default(0)
  openingStock      Float               @default(0)
  quantityOnHand    Float               @default(0)
  invoiceLines      InvoiceLine[]
  piLines           PILine[]
  company           Company             @relation(fields: [companyId], references: [id])
  poLines           PurchaseOrderLine[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Project {
  id           String             @id
  code         String             @unique
  name         String
  companyId    String
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime
  journalLines JournalEntryLine[]
  company      Company            @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

model PurchaseOrder {
  id                   String              @id
  poNumber             String              @unique
  companyId            String
  supplierId           String
  lcId                 String?
  poDate               DateTime            @default(now())
  expectedDeliveryDate DateTime?
  currency             String              @default("BDT")
  exchangeRate         Float               @default(1)
  totalForeign         Float               @default(0)
  totalBDT             Float               @default(0)
  status               String              @default("DRAFT")
  createdById          String
  approvedById         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime
  company              Company             @relation(fields: [companyId], references: [id])
  lc                   LC?                 @relation(fields: [lcId], references: [id])
  supplier             Vendor              @relation(fields: [supplierId], references: [id])
  lines                PurchaseOrderLine[]

  @@index([companyId])
  @@index([lcId])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String        @id
  purchaseOrderId String
  itemDescription String
  quantity        Float         @default(1)
  unitPrice       Float
  total           Float
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model Role {
  id          String     @id
  name        String     @unique
  description String?
  isSystem    Boolean    @default(false)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  userRoles   UserRole[]
}

model User {
  id                  String           @id
  email               String           @unique
  password            String
  firstName           String
  lastName            String
  isActive            Boolean          @default(true)
  maxCompanies        Int              @default(1)
  managerId           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  address             String?
  phone               String?
  performedActivities ActivityLog[]    @relation("ActivityLog_performedByIdToUser")
  targetActivities    ActivityLog[]    @relation("ActivityLog_targetUserIdToUser")
  uploadedAttachments Attachment[]
  approvedInvoices    Invoice[]        @relation("Invoice_approvedByIdToUser")
  createdInvoices     Invoice[]        @relation("Invoice_createdByIdToUser")
  rejectedInvoices    Invoice[]        @relation("Invoice_rejectedByIdToUser")
  verifiedInvoices    Invoice[]        @relation("Invoice_verifiedByIdToUser")
  approvedJournals    JournalEntry[]   @relation("JournalEntry_approvedByIdToUser")
  createdJournals     JournalEntry[]   @relation("JournalEntry_createdByIdToUser")
  rejectedJournals    JournalEntry[]   @relation("JournalEntry_rejectedByIdToUser")
  verifiedJournals    JournalEntry[]   @relation("JournalEntry_verifiedByIdToUser")
  manager             User?            @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates        User[]           @relation("ManagerSubordinates")
  userCompanies       UserCompany[]
  permissions         UserPermission[]
  userRoles           UserRole[]
}

model UserCompany {
  id                    String    @id
  userId                String
  companyId             String
  isDefault             Boolean   @default(false)
  canDeleteCompany      Boolean   @default(false)
  canEditCompany        Boolean   @default(false)
  canManageOwners       Boolean   @default(false)
  capitalAccountCode    String?
  currentCapitalBalance Float     @default(0)
  din                   String?
  drawingAccountCode    String?
  fatherMotherName      String?
  isMainOwner           Boolean   @default(false)
  joiningDate           DateTime?
  mobile                String?
  nidPassport           String?
  openingCapital        Float     @default(0)
  ownershipPercentage   Float     @default(0)
  ownershipType         String?
  permanentAddress      String?
  tin                   String?
  tinCertificateUrl     String?
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model UserPermission {
  id         String  @id
  userId     String
  module     String
  canCreate  Boolean @default(false)
  canVerify  Boolean @default(false)
  canApprove Boolean @default(false)
  canView    Boolean @default(true)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model UserRole {
  id     String @id
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Vendor {
  id                String             @id
  code              String             @unique
  name              String
  companyId         String
  email             String?
  phone             String?
  address           String?
  city              String?
  country           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  balanceType       String?
  contactPerson     String?
  creditLimit       Float?
  openingBalance    Float              @default(0)
  preferredCurrency String             @default("BDT")
  tinVat            String?
  paymentTerms      String             @default("COD")
  bills             Bill[]
  invoices          Invoice[]
  journalLines      JournalEntryLine[]
  lcs               LC[]
  pis               PI[]
  purchaseOrders    PurchaseOrder[]
  company           Company            @relation(fields: [companyId], references: [id])

  @@index([companyId])
}
